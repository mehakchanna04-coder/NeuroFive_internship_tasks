{
  "name": "task-crud-api",
  "version": "2.0.0",
  "description": "CRUD API for Tasks, now backed by MongoDB instead of in-memory storage",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:pretty": "nodemon server.js | pino-pretty",
    "seed": "node seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.5.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "pino-pretty": "^11.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
